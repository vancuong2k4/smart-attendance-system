# ============================================
# Smart Attendance System — Environment Variables
# Copy file này thành .env.local và điền giá trị
# ============================================

# ------ DATABASE ------
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/smart_attendance"

# ------ REDIS ------
REDIS_URL="redis://localhost:6385"

# ------ NEXTAUTH ------
NEXTAUTH_SECRET="your-super-secret-key-change-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ------ FILE STORAGE (Optional) ------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ------ EMAIL (Optional) ------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@company.com"

# ------ APP CONFIG ------
NEXT_PUBLIC_APP_NAME="Smart Attendance"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
